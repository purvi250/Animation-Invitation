{
  "name": "kenvi-puru-reception-storybook",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive, scroll-driven storybook invitation to the wedding reception of Kenvi Dwivedi & Puru Tyagi.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "dev": "node tools/serve.mjs",
    "phone": "node tools/serve.mjs --lan",
    "check": "node tools/check.mjs",
    "test": "node --test tests/unit.test.mjs && node tests/e2e.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "build": "node tools/build.mjs",
    "preview": "node tools/serve.mjs --dir=dist",
    "ics": "node tools/make-ics.mjs",
    "paint": "node tools/paint-scenery.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "puppeteer-core": "^25.13.0"
  }
}
